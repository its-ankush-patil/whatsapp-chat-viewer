{
  "name": "whatsapp-chat-viewer",
  "description": "Render exported WhatsApp chats (.txt + media) in a pixel-perfect WhatsApp UI, with mobile view and PNG screenshots. 100% client-side.",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "node --test",
    "e2e": "node scripts/e2e.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "docs:screenshots": "node scripts/capture-docs.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "html2canvas-pro": "^2.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.57.0",
    "vite": "^8.3.4"
  }
}
